---
import Logo from '../assets/brand/logo-light.svg';
import { paths, site, words, type Lang } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = words[lang];
const year = new Date().getFullYear();
---

<footer class="bg-ink-950 text-white/80">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <Logo class="h-9 w-auto" aria-hidden="true" />
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/65">
        {lang === 'nb'
          ? 'Mobilplattform for samhandling i prosjekter, overlevering og drift.'
          : 'Mobile platform for collaboration in projects, hand over and maintenance.'}
      </p>
      <p class="mt-6 text-xs font-semibold uppercase tracking-wider text-brand-500">{t.getTheApp}</p>
      <div class="mt-3 flex flex-wrap gap-3">
        <a href={site.apps.ios} class="rounded-md border border-white/20 px-3 py-2 text-sm font-semibold text-white hover:border-white/50">App Store</a>
        <a href={site.apps.android} class="rounded-md border border-white/20 px-3 py-2 text-sm font-semibold text-white hover:border-white/50">Google Play</a>
      </div>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-brand-500">{t.support}</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={site.phone.href} class="hover:text-white">{site.phone.display}</a></li>
        <li><a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a></li>
        <li><a href={paths.contact[lang]} class="hover:text-white">{t.contactUs}</a></li>
        <li><a href={site.login} class="hover:text-white">{t.login}</a></li>
      </ul>
      <div class="mt-5 flex gap-4">
        <a href={site.social.linkedin} class="hover:text-white" aria-label="LinkedIn">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"></path></svg>
        </a>
        <a href={site.social.facebook} class="hover:text-white" aria-label="Facebook">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.41 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"></path></svg>
        </a>
      </div>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-brand-500">{t.offices}</h2>
      <ul class="mt-4 space-y-4 text-sm">
        {
          site.offices.map((office) => (
            <li>
              <span class="font-semibold text-white">{office.name[lang]}</span>
              <br />
              {office.lines.map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-6 text-xs text-white/55 sm:px-6 md:flex-row md:items-center md:justify-between">
      <p>© {year} Viscenario AS. {t.rights}</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        <li><a href={paths.terms[lang]} class="hover:text-white">{t.legal.terms}</a></li>
        <li><a href={paths.privacy[lang]} class="hover:text-white">{t.legal.privacy}</a></li>
        <li><a href={paths.ip[lang]} class="hover:text-white">{t.legal.ip}</a></li>
      </ul>
    </div>
  </div>
</footer>
