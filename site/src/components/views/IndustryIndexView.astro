---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import DemoBand from '../DemoBand.astro';
import { paths, detailBase, words, type Lang } from '../../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = words[lang];
const industries = (await getCollection('industries', (e) => e.id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
const intro =
  lang === 'nb'
    ? 'Viscenario brukes av entreprenører, utbyggere, byggeiere og driftsselskaper — hver med sine egne arbeidsflyter.'
    : 'Viscenario is used by construction companies, property developers, building owners and maintenance companies — each with their own way of working.';
---

<Base lang={lang} title={t.nav.industry} description={intro} alternate={paths.industry[lang === 'en' ? 'nb' : 'en']}>
  <PageHero title={t.nav.industry} intro={intro} />
  <section class="bg-ink-50">
    <ul class="mx-auto grid max-w-6xl gap-6 px-4 py-14 sm:px-6 md:grid-cols-2">
      {
        industries.map((e) => (
          <li class="flex flex-col rounded-xl border border-ink-100 bg-white p-6 shadow-sm">
            <h2 class="text-xl font-bold text-ink-900">{e.data.title}</h2>
            <p class="mt-3 flex-1 leading-relaxed text-ink-600">{e.data.summary}</p>
            <a
              href={`${detailBase.industries[lang]}${e.id.split('/')[1]}/`}
              class="mt-5 inline-flex items-center gap-1 font-semibold text-brand-600 hover:text-brand-700"
            >
              {t.readMore}
              <span class="sr-only">: {e.data.title}</span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  <DemoBand lang={lang} />
</Base>
