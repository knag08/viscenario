---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DemoBand from '../DemoBand.astro';
import Illustration from '../../assets/brand/hero-illustration.svg';
import banner from '../../assets/brand/banner.jpg';
import home from '../../data/home.json';
import groups from '../../data/product-groups.json';
import { media } from '../../data/media';
import { logoName } from '../../data/logos';
import { paths, detailBase, words, type Lang } from '../../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = words[lang];
const h = home[lang];
const productGroups = groups[lang].groups;
const industries = (await getCollection('industries', (e) => e.id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);

const title =
  lang === 'nb'
    ? 'Viscenario – mobilplattform for tilvalg, befaring, HMS, KS og FDV'
    : 'Viscenario – mobile platform for construction projects, hand over and maintenance';
const description =
  lang === 'nb'
    ? 'Viscenario samler tilvalg, befaring, ettermarked, HMS, KS, FDV-dokumentasjon og integrasjoner i én mobilplattform for entreprenører, utbyggere og byggeiere.'
    : 'Viscenario brings options, inspection, aftermarket, HSE, quality assurance, maintenance documentation and integrations into one mobile platform for construction and property.';
---

<Base lang={lang} title={title} description={description} alternate={paths.home[lang === 'en' ? 'nb' : 'en']} bareTitle>
  <section class="relative overflow-hidden bg-ink-900 text-white">
    <Image src={banner} alt="" class="absolute inset-0 h-full w-full object-cover opacity-40" widths={[800, 1400, 1920]} sizes="100vw" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-r from-ink-950/90 via-ink-900/70 to-ink-900/30" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 md:grid-cols-2 md:py-24">
      <div>
        <h1 class="text-4xl font-bold leading-tight sm:text-5xl">{h.heading}</h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/85 sm:text-xl">{h.subheading}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={paths.products[lang]} class="rounded-md bg-brand-500 px-6 py-3 font-semibold text-white hover:bg-brand-600">
            {t.nav.products}
          </a>
          <a href={paths.demo[lang]} class="rounded-md border border-white/40 px-6 py-3 font-semibold text-white hover:bg-white/10">
            {t.bookDemo}
          </a>
        </div>
      </div>
      <Illustration class="mx-auto h-auto w-full max-w-md" aria-hidden="true" />
    </div>
  </section>

  <section aria-label={lang === 'nb' ? 'Viscenario i tall' : 'Viscenario in numbers'} class="border-b border-ink-100 bg-white">
    <dl class="mx-auto grid max-w-3xl grid-cols-2 gap-6 px-4 py-10 text-center sm:px-6">
      {
        h.counts.map((c) => (
          <div>
            <dt class="text-sm font-semibold uppercase tracking-wider text-ink-500">{c.label}</dt>
            <dd class="order-first text-4xl font-bold text-brand-500 sm:text-5xl">{c.value.replace(' +', '+')}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="bg-ink-50">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="text-3xl font-bold text-ink-900">{t.nav.products}</h2>
      <p class="mt-2 max-w-2xl text-ink-600">
        {lang === 'nb'
          ? 'Én plattform fra tilvalg og befaring til overlevering, FDV og drift.'
          : 'One platform from options and inspection through hand over, documentation and maintenance.'}
      </p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          productGroups.map((g) => (
            <li>
              <a
                href={g.href}
                class="group flex h-full items-center gap-4 rounded-xl border border-ink-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-md"
              >
                {g.icon && <Image src={media(g.icon)} alt="" width={56} height={56} class="h-14 w-14 shrink-0" />}
                <span class="font-semibold text-ink-900 group-hover:text-brand-600">{g.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="text-3xl font-bold text-ink-900">{t.nav.industry}</h2>
      <ul class="mt-8 grid gap-6 md:grid-cols-2">
        {
          industries.map((e) => (
            <li class="flex flex-col rounded-xl border border-ink-100 p-6">
              <h3 class="text-xl font-bold text-ink-900">{e.data.title}</h3>
              <p class="mt-3 flex-1 leading-relaxed text-ink-600">{e.data.summary}</p>
              <a
                href={`${detailBase.industries[lang]}${e.id.split('/')[1]}/`}
                class="mt-5 inline-flex items-center gap-1 font-semibold text-brand-600 hover:text-brand-700"
              >
                {t.readMore}
                <span class="sr-only">: {e.data.title}</span>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-ink-100 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <h2 class="text-center text-sm font-semibold uppercase tracking-wider text-ink-500">
        {lang === 'nb' ? 'Noen av våre kunder' : 'Some of our customers'}
      </h2>
      <ul class="mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-8 sm:grid-cols-3 lg:grid-cols-6">
        {
          h.logos.map((logo) => (
            <li class="flex justify-center">
              <a href={paths.customers[lang]} class="block opacity-80 grayscale transition hover:opacity-100 hover:grayscale-0">
                <Image src={media(logo)} alt={logoName(logo)} width={160} class="h-12 w-auto object-contain" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <DemoBand lang={lang} />
</Base>
