---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import DemoBand from '../DemoBand.astro';
import { paths, words, type Lang } from '../../data/site';

/** One product or industry page. The two share a shape: a title and a body. */
interface Props {
  entry: CollectionEntry<'products'> | CollectionEntry<'industries'>;
  lang: Lang;
  section: 'products' | 'industry';
}

const { entry, lang, section } = Astro.props;
const t = words[lang];
const { Content } = await render(entry);
const eyebrow = { label: t.nav[section], href: paths[section][lang] };
---

<Base lang={lang} title={entry.data.title} description={entry.data.description}>
  <PageHero title={entry.data.title} eyebrow={eyebrow} />
  <article class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="rich">
      <Content />
    </div>
  </article>
  <DemoBand lang={lang} />
</Base>
