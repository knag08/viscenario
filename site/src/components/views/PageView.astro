---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import ContactForm from '../ContactForm.astro';
import { paths, site, words, type Lang, type PageKey } from '../../data/site';

interface Props {
  entry: CollectionEntry<'pages'>;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const t = words[lang];
const key = entry.id.split('/')[1] as PageKey;
const { Content } = await render(entry);
const withForm = key === 'contact' || key === 'demo';
const other: Lang = lang === 'en' ? 'nb' : 'en';
---

<Base lang={lang} title={entry.data.title} description={entry.data.description} alternate={paths[key][other]}>
  <PageHero title={entry.data.title} />

  {
    withForm ? (
      <section class="mx-auto grid max-w-6xl gap-12 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-5">
        <div class="lg:col-span-2">
          <div class="rich">
            <Content />
          </div>
          <dl class="mt-8 space-y-3 text-ink-700">
            <div>
              <dt class="text-sm font-semibold uppercase tracking-wider text-ink-500">{t.form.phone}</dt>
              <dd><a class="font-semibold text-brand-600 hover:text-brand-700" href={site.phone.href}>{site.phone.display}</a></dd>
            </div>
            <div>
              <dt class="text-sm font-semibold uppercase tracking-wider text-ink-500">{t.form.email}</dt>
              <dd><a class="font-semibold text-brand-600 hover:text-brand-700" href={`mailto:${site.email}`}>{site.email}</a></dd>
            </div>
          </dl>
          {key === 'contact' && (
            <>
              <h2 class="mt-10 text-lg font-bold text-ink-900">{t.offices}</h2>
              <ul class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-1">
                {site.offices.map((office) => (
                  <li class="text-ink-700">
                    <span class="font-semibold text-ink-900">{office.name[lang]}</span>
                    {office.lines.map((line) => (
                      <>
                        <br />
                        {line}
                      </>
                    ))}
                  </li>
                ))}
              </ul>
            </>
          )}
        </div>
        <div class="rounded-xl border border-ink-100 bg-white p-6 shadow-sm sm:p-8 lg:col-span-3">
          <h2 class="text-2xl font-bold text-ink-900">{key === 'demo' ? t.bookDemo : t.form.heading}</h2>
          <p class="mb-6 mt-2 text-ink-600">{t.form.intro}</p>
          <ContactForm lang={lang} topic={key === 'demo' ? t.bookDemo : undefined} />
        </div>
      </section>
    ) : (
      <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
        <div class="rich">
          <Content />
        </div>
        {key === 'account' && (
          <div class="mt-10 rounded-xl border border-ink-100 bg-ink-50 p-6">
            <h2 class="text-lg font-bold text-ink-900">{t.getTheApp}</h2>
            <p class="mt-2 text-ink-600">
              {lang === 'nb'
                ? 'Registrering på nettsiden er midlertidig stengt. Ta kontakt, så hjelper vi deg med en konto.'
                : 'Signing up on the website is paused for now. Contact us and we will help you get an account.'}
            </p>
            <div class="mt-4 flex flex-wrap gap-3">
              <a href={site.apps.ios} class="rounded-md bg-ink-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-ink-800">App Store</a>
              <a href={site.apps.android} class="rounded-md bg-ink-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-ink-800">Google Play</a>
              <a href={paths.contact[lang]} class="rounded-md border border-ink-200 px-4 py-2.5 text-sm font-semibold text-ink-900 hover:border-ink-500">{t.contactUs}</a>
            </div>
          </div>
        )}
      </article>
    )
  }
</Base>
