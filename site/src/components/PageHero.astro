---
interface Props {
  title: string;
  intro?: string;
  /** Small label above the title, e.g. the section a detail page belongs to. */
  eyebrow?: { label: string; href: string };
}

const { title, intro, eyebrow } = Astro.props;
---

<section class="relative overflow-hidden bg-ink-900 text-white">
  <div
    class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-brand-500/15 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    {
      eyebrow && (
        <a href={eyebrow.href} class="text-sm font-semibold uppercase tracking-wider text-brand-500 hover:text-brand-200">
          {eyebrow.label}
        </a>
      )
    }
    <h1 class="mt-2 max-w-3xl text-3xl font-bold leading-tight sm:text-4xl lg:text-5xl">{title}</h1>
    {intro && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/75">{intro}</p>}
    <slot />
  </div>
</section>
