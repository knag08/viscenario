---
import Base from '../layouts/Base.astro';
import { paths, words } from '../data/site';

// GitHub Pages serves this one file for every missing address, in either
// language, so it says it both ways.
const en = words.en.notFound;
const nb = words.nb.notFound;
---

<Base lang="en" title={en.title} description={en.body}>
  <section class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6">
    <p class="text-6xl font-bold text-brand-500">404</p>
    <h1 class="mt-4 text-3xl font-bold text-ink-900">{en.title}</h1>
    <p class="mt-3 text-ink-600">{en.body}</p>
    <p class="mt-1 text-ink-600" lang="nb">{nb.title}. {nb.body}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={paths.home.en} class="rounded-md bg-brand-500 px-5 py-3 font-semibold text-white hover:bg-brand-600">{en.home}</a>
      <a href={paths.home.nb} lang="nb" class="rounded-md border border-ink-200 px-5 py-3 font-semibold text-ink-900 hover:border-ink-500">{nb.home}</a>
    </div>
  </section>
</Base>
