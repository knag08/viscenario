---
import { getCollection } from 'astro:content';
import PageView from '../components/views/PageView.astro';

export async function getStaticPaths() {
  const entries = await getCollection('pages', (e) => e.id.startsWith('en/'));
  return entries.map((entry) => ({ params: { page: entry.data.path }, props: { entry } }));
}

const { entry } = Astro.props;
---

<PageView entry={entry} lang="en" />
