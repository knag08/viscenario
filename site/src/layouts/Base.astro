---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, words, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** The same page in the other language, when there is one. */
  alternate?: string;
  /** Home pages use the title as given, without the " · Viscenario" suffix. */
  bareTitle?: boolean;
}

const { lang, title, description, alternate, bareTitle = false } = Astro.props;
const t = words[lang];
const other: Lang = lang === 'en' ? 'nb' : 'en';
const pageTitle = bareTitle ? title : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const otherHome = other === 'en' ? '/' : '/nb/';
const switchTo = alternate ?? otherHome;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  logo: `${site.url}/icon-512.png`,
  email: site.email,
  telephone: '+47 22 53 50 06',
  sameAs: [site.social.facebook, site.social.linkedin],
};
---

<!doctype html>
<html lang={lang === 'nb' ? 'nb' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Send only the origin to other sites, never the path somebody was reading. -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alternate && (
        <>
          <link rel="alternate" hreflang={lang} href={canonical} />
          <link rel="alternate" hreflang={other} href={new URL(alternate, site.url).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(lang === 'en' ? Astro.url.pathname : alternate, site.url).href} />
        </>
      )
    }

    <!-- /favicon.ico is requested whether or not it is declared; it exists at the root. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#242630" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/og-image.png`} />
    <meta property="og:locale" content={lang === 'nb' ? 'nb_NO' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body class="flex min-h-screen flex-col font-sans antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:text-ink-900 focus:shadow"
    >
      {t.skip}
    </a>
    <Header lang={lang} switchTo={switchTo} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
